{
  "expo": {
    "name": "moderncoffee",
    "slug": "moderncoffee",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "assets/images/ic_launcher_round.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.robotlions.moderncoffee",
      "buildNumber": "28"
    },
    "android": {
      "package": "com.robotlions.moderncoffee",
      "permissions": [
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "f2b30b22-baf3-4b00-adf2-8acfd85d04f0"
      }
    }
  }
}
